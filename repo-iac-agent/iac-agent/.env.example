# --- Non-secret config ---
TERRAFORM_DIR=infra/environments/dev
BACKEND_URL=http://localhost:8000
SCAN_INTERVAL_SECONDS=900
APPLY_POLL_INTERVAL_SECONDS=60
HIGH_RISK_THRESHOLD=70
DEBUG=true

# --- Secret --- local dev only, gitignored.
# Must match AGENT_API_TOKEN on the chatbot backend.
AGENT_API_TOKEN=

# --- Conversational provisioner (any cloud) ---
# Hub that renders the agent office. Leave empty to disable events.
OFFICE_URL=http://localhost:8200
OMNI_ROUTE_BASE_URL=http://localhost:4000/v1
IAC_MODEL=iac-agent
WORKSPACE_DIR=workspaces
VALIDATE_WITH_TERRAFORM=true
# Cloud credentials (e.g. HCLOUD_TOKEN, ARM_*, GOOGLE_*) go in the environment
# of the process that runs plan/apply. The LLM never sees them.
