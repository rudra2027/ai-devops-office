# Copy to .env (never commit .env). Everything here is OPTIONAL for the no-keys demo:
#   python repo-office/shared/run_all.py --dev-auth --stub
# Real models and real sign-in need the values below.

# --- models (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PRIMARY_MODEL=openai/gpt-6.1-sol
LLM_SECONDARY_MODEL=anthropic/claude-sonnet-5.5
STT_MODEL=google/gemini-3.5-flash

# --- sign-in and data (Supabase). Run repo-office/shared/supabase/0001_init.sql first. ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated. These accounts are the admin: they see the Agent Office and every agent UI.
ADMIN_EMAILS=

# --- optional ---
REDIS_URL=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-devops-office

# --- service-to-service. Generate your own: python -c "import secrets; print(secrets.token_hex(24))" ---
INGEST_TOKEN=
OFFICE_URL=http://127.0.0.1:8200
OBS_URL=http://127.0.0.1:8400
