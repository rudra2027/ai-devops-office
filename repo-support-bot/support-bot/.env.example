# Secrets live in the shared multiagent/.env (outside every repo). Copy keys here only for a standalone deploy.
OPENROUTER_API_KEY=
LLM_PRIMARY_MODEL=openai/gpt-6.1-sol
LLM_SECONDARY_MODEL=anthropic/claude-sonnet-5.5
STT_MODEL=google/gemini-3.5-flash
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
REDIS_URL=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=four-agent
OFFICE_URL=http://localhost:8200
OBS_URL=http://localhost:8400
INGEST_TOKEN=change-me
# AUTH_MODE=dev accepts "dev:<email>" tokens. For local tests ONLY, never in a deployed environment.
AUTH_MODE=supabase
